<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve assets directly from /public when the project root is used as Apache document root.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/emindtutor/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/emindtutor/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Forward all application routes to Laravel's front controller.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^ index.php [L]
</IfModule>
